{
  "name": "@capora/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply capora-db --local",
    "cf:types": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@capora/config": "workspace:*",
    "@capora/db": "workspace:*",
    "@capora/mcp": "workspace:*",
    "@capora/provider-sdk": "workspace:*",
    "@capora/types": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "latest",
    "hono": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
