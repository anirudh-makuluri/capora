# Worker secrets: copy to apps/worker/.dev.vars for local sandbox testing.
# pnpm setup:local creates safe local demo defaults automatically.
# All capabilities on Capora are for demonstration purposes only.
# Paid purchases use cUSD escrow. PayPal Sandbox is exclusively for demo-token top-ups.
DEV_MODE=false
PAYMENT_MODE=sandbox
PAYPAL_ENVIRONMENT=sandbox
CAPORA_BASE_URL=http://localhost:5173
DASHBOARD_USER_ID=user_demo
DASHBOARD_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=
DEMO_PROVIDER_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional until configured. See docs/bank.md. Only Base Sepolia (84532) is permitted.
BANK_ENABLED=false
BANK_RPC_URL=
BANK_DEPLOYMENT=
BANK_MARKETPLACE_FEE_BPS=250
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=
# Separate P-256 owner key for append-only condition-set enrollment, not an Ethereum key.
PRIVY_ENROLLMENT_AUTHORIZATION_KEY=
BANK_PRIVY_WALLET_SET_ID=
BANK_PRIVY_CHIT_SET_ID=
# AI strategy runs stay disabled until an owner sets an interval and daily call cap.
BANK_PLANNER_API_KEY=
BANK_PLANNER_MODEL=
# Exact operator-approved HTTPS hostnames, comma separated. No wildcard or private hosts.
PROVIDER_ALLOWED_HOSTS=
# Server-only admin email allowlist (comma separated). Configure in .dev.vars locally
# and as a Worker secret for deployment. Never expose this list to the frontend.
ADMIN_EMAILS=
